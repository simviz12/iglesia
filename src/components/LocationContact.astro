---
import { siteConfig } from '../data/siteConfig';
import { PrayerRequestForm } from './PrayerRequestForm';
---

<section id="intenciones" class="w-full bg-surface-container-low py-20 border-t border-surface-container">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Prayer Request Form Island (7 cols) -->
      <div class="lg:col-span-7">
        <PrayerRequestForm client:load />
      </div>

      <!-- Right Column: Location, WhatsApp & Contact Details (5 cols) -->
      <div id="contacto" class="lg:col-span-5 flex flex-col gap-6">
        <!-- WhatsApp Direct Card -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl shadow-sacred border border-surface-container flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div>
              <span class="font-bold text-base text-charcoal block">Canal Directo de WhatsApp</span>
              <span class="text-xs text-charcoal-muted">Atención rápida para consultas litúrgicas</span>
            </div>
          </div>
          <p class="text-xs text-charcoal-muted leading-relaxed">
            ¿Deseas concertar confesión privada, bendición de un hogar o consultar disponibilidad de fechas para bodas y bautizos?
          </p>
          <a
            href={`https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(siteConfig.contact.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold transition-colors flex items-center justify-center gap-2 shadow-sm"
          >
            <span>Escribir por WhatsApp ({siteConfig.contact.whatsapp})</span>
          </a>
        </div>

        <!-- Location & Map Info -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl shadow-sacred border border-surface-container flex flex-col gap-4">
          <div class="flex items-center gap-2 text-charcoal font-bold text-base">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>¿Dónde encontrarnos?</span>
          </div>

          <div class="text-xs text-charcoal-muted leading-relaxed flex flex-col gap-1">
            <span class="font-semibold text-charcoal">{siteConfig.address.street}, {siteConfig.address.neighborhood}</span>
            <span>{siteConfig.address.metroInfo}</span>
            <span class="text-primary font-medium">{siteConfig.address.parkingInfo}</span>
          </div>

          <!-- Location preview frame -->
          <div class="w-full h-36 bg-surface-container-high rounded-xl overflow-hidden relative shadow-inner">
            <img 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCad0ruLjnTd1k-Ja-8jGj67lkMpBxZekwQuvKRrYFBiIULRZHYE2iS6V21_rfLzwZ_9l2g1exeh9E8jvrwM8xhMfjWKxiVMsZYo1YEpFzEUDw_tYktUQq4_K8lgWeG7uHZ4OajHOvnj0c3BHImXcNnB2T1--PEQJ2n8YbjvWzTeFqqRRxo2qyyVQP6xQd1Fa5WKZPypiGJUyvo9HGDl8sZyj1vKZhF_5ugS-mP7iaKkvWE7NFKwe8" 
              alt="Ubicación Parroquia Santa Mónica"
              class="w-full h-full object-cover"
            />
          </div>

          <a
            href={siteConfig.address.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-primary hover:underline flex items-center justify-center gap-1.5 pt-1"
          >
            <span>Abrir en Google Maps / GPS</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
