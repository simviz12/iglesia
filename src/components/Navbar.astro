---
import { siteConfig } from '../data/siteConfig';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl border-b border-surface-container transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    <!-- Brand / Logo -->
    <a href="#" class="flex items-center gap-3 shrink-0 group">
      <img 
        src="/images/logo.png" 
        alt="Emblema Parroquial Cruz y Sol" 
        class="h-10 w-auto object-contain transition-transform group-hover:scale-105" 
      />
      <div class="flex flex-col">
        <span class="font-serif font-bold text-lg sm:text-xl text-primary leading-tight tracking-tight">
          {siteConfig.shortName}
        </span>
        <span class="text-[11px] uppercase tracking-wider text-charcoal-muted font-medium hidden sm:inline-block">
          Diócesis y Comunidad Pastoral
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6">
      <a href="#inicio" class="text-sm font-semibold text-primary transition-colors py-1 border-b-2 border-primary">
        Inicio
      </a>
      <a href="#horarios" class="text-sm font-medium text-charcoal-muted hover:text-primary transition-colors py-1">
        Horarios de Misas
      </a>
      <a href="#cronograma" class="text-sm font-medium text-charcoal-muted hover:text-primary transition-colors py-1">
        Fiestas & Agenda
      </a>
      <a href="#sacramentos" class="text-sm font-medium text-charcoal-muted hover:text-primary transition-colors py-1">
        Sacramentos
      </a>
      <a href="#caritas" class="text-sm font-medium text-charcoal-muted hover:text-primary transition-colors py-1">
        Pastoral Social
      </a>
      <a href="#donaciones" class="text-sm font-medium text-charcoal-muted hover:text-primary transition-colors py-1">
        Ofrenda
      </a>
    </nav>

    <!-- Header Actions (CTA) -->
    <div class="flex items-center gap-3 shrink-0">
      <a 
        href="#horarios" 
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 bg-surface-container text-charcoal hover:bg-surface-container-high rounded-md text-xs font-semibold tracking-wide transition-all border border-gold/30 hover:border-gold"
      >
        Horarios de Culto
      </a>
      <a 
        href={`https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(siteConfig.contact.whatsappMessage)}`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center px-4 py-2 bg-primary text-white hover:bg-primary-hover rounded-md text-xs font-semibold tracking-wide transition-all shadow-primary"
      >
        Planear Visita
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button 
        id="mobile-menu-btn" 
        aria-label="Abrir menú" 
        class="lg:hidden p-2 rounded-md text-charcoal hover:bg-surface-container transition-colors"
      >
        <svg id="menu-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Nav Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-surface-container-low border-b border-surface-container px-6 py-5 shadow-lg">
    <div class="flex flex-col gap-3">
      <a href="#inicio" class="text-base font-semibold text-primary py-2 border-b border-surface-container">Inicio</a>
      <a href="#horarios" class="text-base font-medium text-charcoal hover:text-primary py-2 border-b border-surface-container">Horarios de Misas</a>
      <a href="#cronograma" class="text-base font-medium text-charcoal hover:text-primary py-2 border-b border-surface-container">Fiestas & Agenda Litúrgica</a>
      <a href="#sacramentos" class="text-base font-medium text-charcoal hover:text-primary py-2 border-b border-surface-container">Sacramentos y Catequesis</a>
      <a href="#caritas" class="text-base font-medium text-charcoal hover:text-primary py-2 border-b border-surface-container">Cáritas y Voluntariado</a>
      <a href="#donaciones" class="text-base font-medium text-charcoal hover:text-primary py-2 border-b border-surface-container">Ofrenda & Sostenimiento</a>
      <a href="#contacto" class="text-base font-medium text-charcoal hover:text-primary py-2">Despacho & Contacto</a>
      
      <div class="pt-3 flex flex-col gap-2">
        <a 
          href={`https://wa.me/${siteConfig.contact.whatsappNumber}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full text-center py-2.5 bg-emerald-700 text-white rounded-md text-sm font-semibold"
        >
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking any nav link
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
