---
import { sacramentsData } from '../data/siteConfig';
---

<section id="sacramentos" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <!-- Section Title -->
  <div class="text-center max-w-2xl mx-auto mb-16 flex flex-col gap-2">
    <span class="text-xs uppercase font-bold tracking-widest text-primary">
      Canales de Gracia y Vida Divina
    </span>
    <h2 class="font-serif text-3xl sm:text-4xl text-charcoal font-bold">
      Los Santos Sacramentos en Nuestra Parroquia
    </h2>
    <p class="text-charcoal-muted text-base leading-relaxed">
      Acompañamos a tu familia en cada etapa del camino de fe, desde el nacimiento hasta la consagración del amor conyugal y la esperanza de la resurrección.
    </p>
  </div>

  <!-- Sacrament Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {sacramentsData.map((sacrament) => (
      <div class="bg-white p-6 sm:p-7 rounded-xl shadow-sacred hover:shadow-lg transition-all duration-300 flex flex-col justify-between border border-surface-container hover:border-gold/50 group">
        <div>
          <!-- Icon -->
          <div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary mb-5 group-hover:bg-primary group-hover:text-white transition-colors">
            {sacrament.id === 'bautismo' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            )}
            {sacrament.id === 'comunion' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {sacrament.id === 'confirmacion' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
              </svg>
            )}
            {sacrament.id === 'matrimonio' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            )}
            {sacrament.id === 'uncion' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {sacrament.id === 'despacho' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
          </div>

          <h3 class="font-serif text-xl text-charcoal font-bold mb-1">
            {sacrament.title}
          </h3>
          
          <p class="text-xs text-charcoal-muted mb-4 leading-relaxed">
            {sacrament.description}
          </p>

          <!-- Requirements Box -->
          <div class="bg-surface-container-low p-3.5 rounded-lg text-charcoal-muted text-xs mb-4 border border-surface-container">
            <span class="font-bold text-charcoal block mb-0.5">{sacrament.requirementsTitle}</span>
            {sacrament.requirements}
          </div>
        </div>

        <a 
          href={sacrament.ctaLink} 
          class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:text-primary-hover group-hover:translate-x-1 transition-all pt-2"
        >
          <span>{sacrament.ctaText}</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    ))}
  </div>
</section>
