---
import { serviceSchedules } from '../data/siteConfig';
---

<section id="horarios" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
    <div class="flex flex-col gap-2 max-w-2xl">
      <div class="flex items-center gap-2 text-primary text-xs uppercase font-bold tracking-widest">
        <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Vida Litúrgica y Celebraciones</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl text-charcoal font-bold">
        Horarios Habituales de Santa Misa y Adoración
      </h2>
      <p class="text-charcoal-muted text-base leading-relaxed">
        Nuestras puertas se abren cada día para la acogida fraterna, el silencio orante y la santa comunión. Te esperamos en el corazón del templo.
      </p>
    </div>

    <!-- Badges / Info tags -->
    <div class="flex items-center gap-2 bg-surface-container-low p-2 rounded-lg shrink-0 border border-surface-container">
      <span class="px-3 py-1 rounded bg-white text-xs font-semibold text-primary shadow-sm border border-gold/20">
        Rito Romano Ordinario
      </span>
      <span class="px-3 py-1 rounded text-xs font-medium text-charcoal-light">
        Templo Climatizado & Accesible
      </span>
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {serviceSchedules.map((schedule) => {
      const isPrimary = schedule.accentColor === 'primary';
      const isGold = schedule.accentColor === 'gold';
      const isSecondary = schedule.accentColor === 'secondary';

      return (
        <div class="bg-white rounded-xl p-6 flex flex-col justify-between shadow-sacred hover:shadow-lg transition-all duration-300 relative overflow-hidden group border border-surface-container hover:border-gold/50">
          <!-- Top Accent Bar -->
          <div 
            class:list={[
              "absolute top-0 left-0 right-0 h-1.5 transition-all",
              isPrimary && "bg-primary",
              isGold && "bg-gold",
              isSecondary && "bg-navy",
              !isPrimary && !isGold && !isSecondary && "bg-surface-container-high"
            ]}
          />

          <div>
            <div class="flex items-center justify-between mb-3">
              <span 
                class:list={[
                  "text-xs uppercase font-bold tracking-wider",
                  isPrimary && "text-primary",
                  isGold && "text-gold",
                  isSecondary && "text-navy",
                  !isPrimary && !isGold && !isSecondary && "text-charcoal-muted"
                ]}
              >
                {schedule.subtitle}
              </span>
              
              <!-- Icon representation -->
              <div class="w-8 h-8 rounded-full bg-surface-container-low flex items-center justify-center text-charcoal group-hover:scale-110 transition-transform">
                {isPrimary && (
                  <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                )}
                {isGold && (
                  <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                )}
                {isSecondary && (
                  <svg class="w-4 h-4 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                )}
                {!isPrimary && !isGold && !isSecondary && (
                  <svg class="w-4 h-4 text-charcoal-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
              </div>
            </div>

            <h3 class="font-serif text-2xl text-charcoal font-bold mb-2">
              {schedule.title}
            </h3>
            
            <p class="text-xs text-charcoal-muted mb-5 leading-relaxed">
              {schedule.description}
            </p>

            <!-- Timetable List -->
            <ul class="flex flex-col gap-2">
              {schedule.items.map((item) => (
                <li 
                  class:list={[
                    "flex flex-col p-2.5 rounded transition-all",
                    item.highlight 
                      ? "bg-primary/10 border border-primary/20" 
                      : "bg-surface-container-low hover:bg-surface-container"
                  ]}
                >
                  <div class="flex items-center justify-between">
                    <span 
                      class:list={[
                        "font-bold text-sm",
                        item.highlight ? "text-primary" : "text-charcoal"
                      ]}
                    >
                      {item.time}
                    </span>
                    {item.badge && (
                      <span class="text-[10px] font-bold uppercase tracking-wider text-primary bg-primary/10 px-2 py-0.5 rounded">
                        {item.badge}
                      </span>
                    )}
                  </div>
                  
                  <span 
                    class:list={[
                      "text-xs mt-0.5 font-medium",
                      item.highlight ? "text-primary" : "text-charcoal"
                    ]}
                  >
                    {item.title}
                  </span>

                  {item.description && (
                    <span class="text-[11px] text-charcoal-light mt-0.5">
                      {item.description}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>

          <!-- Card Footer Status -->
          <div class="mt-6 pt-3 border-t border-surface-container flex items-center justify-between text-xs text-charcoal-muted">
            <span class="text-[11px] text-charcoal-light">{schedule.footerNote}</span>
            <span class="font-semibold text-primary">{schedule.footerStatus}</span>
          </div>
        </div>
      );
    })}
  </div>
</section>
