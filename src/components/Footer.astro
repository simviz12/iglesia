---
import { siteConfig } from '../data/siteConfig';
---

<footer class="w-full bg-surface-container-high/60 border-t border-surface-container text-charcoal-muted pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
    <!-- Col 1: Identity -->
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <img 
          src="/images/logo.png" 
          alt="Emblema Parroquial" 
          class="h-9 w-auto object-contain"
        />
        <span class="font-serif font-bold text-xl text-primary">
          {siteConfig.shortName}
        </span>
      </div>
      <p class="text-xs leading-relaxed text-charcoal-muted">
        Una comunidad viva y contemplativa donde la fe florece en el amor fraterno, el culto litúrgico reverente y el servicio a los hermanos más necesitados.
      </p>
      <div class="flex items-center gap-2 pt-2">
        <a 
          href={`https://wa.me/${siteConfig.contact.whatsappNumber}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="WhatsApp"
          class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center hover:bg-emerald-600 hover:text-white transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Col 2: Despacho Parroquial -->
    <div class="flex flex-col gap-3">
      <h4 class="text-xs uppercase font-bold tracking-wider text-charcoal">
        Despacho Parroquial
      </h4>
      <div class="flex flex-col gap-1 text-xs">
        <span class="font-bold text-primary">Lunes a Viernes</span>
        <span>Mañana: {siteConfig.officeHours.weekdays}</span>
        <span>Tarde: {siteConfig.officeHours.weekdaysAfternoon}</span>
      </div>
      <div class="flex flex-col gap-1 text-xs pt-1">
        <span class="font-bold text-primary">Sábados</span>
        <span>{siteConfig.officeHours.saturdays}</span>
      </div>
    </div>

    <!-- Col 3: Confesiones -->
    <div class="flex flex-col gap-3">
      <h4 class="text-xs uppercase font-bold tracking-wider text-charcoal">
        Confesiones & Perdón
      </h4>
      <div class="flex flex-col gap-1 text-xs">
        <span class="font-bold text-primary">Martes a Sábado</span>
        <span>30 minutos antes de cada Santa Misa</span>
      </div>
      <div class="flex flex-col gap-1 text-xs pt-1">
        <span class="font-bold text-primary">Domingos</span>
        <span>Continuo durante las celebraciones</span>
      </div>
    </div>

    <!-- Col 4: Contacto & Asistencia -->
    <div class="flex flex-col gap-3">
      <h4 class="text-xs uppercase font-bold tracking-wider text-charcoal">
        Contacto Directo
      </h4>
      <div class="flex flex-col gap-2 text-xs">
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{siteConfig.address.street}, {siteConfig.address.neighborhood}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Teléfono: {siteConfig.contact.phone}</span>
        </div>
        <div class="flex items-center gap-2 text-primary font-medium">
          <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Urgencia Sacramental 24h: {siteConfig.contact.emergencyPhone}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{siteConfig.contact.email}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright Sub-bar -->
  <div class="border-t border-surface-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
    <span>© 2025 {siteConfig.name}. Todos los derechos reservados.</span>
    <div class="flex items-center gap-4">
      <span>Paz y Bien</span>
      <span>•</span>
      <span>Diócesis Metropolitana</span>
    </div>
  </div>
</footer>
